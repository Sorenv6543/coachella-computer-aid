# Illustration assets and finished deliverables — store as Git LFS pointers
# instead of full binaries in git history. Run `git lfs install` once per
# clone (see tools/illustrations/README.md) before these take effect.
src/assets/images/**/*.png filter=lfs diff=lfs merge=lfs -text
src/assets/images/**/*.jpg filter=lfs diff=lfs merge=lfs -text
src/assets/images/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
src/assets/images/**/*.webp filter=lfs diff=lfs merge=lfs -text
files/**/*.png filter=lfs diff=lfs merge=lfs -text
files/**/*.jpg filter=lfs diff=lfs merge=lfs -text
files/**/*.pdf filter=lfs diff=lfs merge=lfs -text
